# Copie para .env (que NUNCA vai para o git) e ajuste se precisar.
# No Docker local estes valores já funcionam sem mudança.

# Senha do Postgres local (container "db")
POSTGRES_PASSWORD=postgres
# Porta do Postgres no seu computador (54322 evita conflito com um Postgres instalado)
DB_PORTA=54322

# Recorte padrão do Radar
RADAR_UF=MG
# Segundos mínimos entre chamadas à API do PNCP (a API devolve 429 se você correr)
RADAR_PNCP_INTERVALO=1.5

# Estratégias de IA (Sprint 8 em diante): fastembed | falso  /  extrativo | ollama
RADAR_EMBEDDINGS=falso
RADAR_RESUMO=extrativo
RADAR_OLLAMA_MODELO=qwen2.5:3b
